---
import { getEntry } from "astro:content";

interface Props {
  locale: string;
  canonicalPath?: string;
  hreflangSuffix?: string;
  pageTitle?: string;
  pageDescription?: string;
}

const {
  locale,
  canonicalPath,
  hreflangSuffix = "",
  pageTitle,
  pageDescription,
} = Astro.props;

const entry = await getEntry("meta", locale);
if (!entry) throw new Error(`Missing meta content for locale: ${locale}`);

const { title: siteTitle, description: siteDescription, ogLocale } = entry.data;

const gtmId = import.meta.env.PUBLIC_GTM_ID;

const siteOrigin = Astro.site?.toString().replace(/\/$/, "") ?? "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteBase = `${siteOrigin}${base}`;

const localePaths: Record<string, string> = {
  fr: "/",
  en: "/en/",
  de: "/de/",
  es: "/es/",
};

const ogLocales: Record<string, string> = {
  fr: "fr_FR",
  en: "en_US",
  de: "de_DE",
  es: "es_ES",
};

const title = pageTitle ?? siteTitle;
const description = pageDescription ?? siteDescription;
const canonicalUrl = canonicalPath
  ? `${siteBase}${canonicalPath}`
  : `${siteBase}${localePaths[locale] ?? "/"}`;
const ogImageUrl = `${siteBase}/open-graph/${locale}.png`;

const alternateOgLocales = Object.entries(ogLocales)
  .filter(([l]) => l !== locale)
  .map(([, og]) => og);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Hostel",
  name: "La Grange de Marie France",
  alternateName: "Gîte La Grange de Marie France",
  description,
  numberOfRooms: 7,
  petsAllowed: false,
  priceRange: "35€ – 65€",
  address: {
    "@type": "PostalAddress",
    streetAddress: "4 avenue de la Ténarèze",
    addressLocality: "Éauze",
    postalCode: "32800",
    addressCountry: "FR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 43.8610716,
    longitude: 0.1033391,
  },
  telephone: "+33661244804",
  email: "lagrangedemariefrance@gmail.com",
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "WiFi", value: true },
    { "@type": "LocationFeatureSpecification", name: "A/C", value: true },
    {
      "@type": "LocationFeatureSpecification",
      name: "Garage vélos et motos",
      value: true,
    },
    {
      "@type": "LocationFeatureSpecification",
      name: "Arrêt de bus",
      value: true,
    },
  ],
  url: siteBase,
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
<link rel="icon" href={`${base}/favicon.ico`} />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />
{alternateOgLocales.map((og) => (
  <meta property="og:locale:alternate" content={og} />
))}

<!-- hreflang -->
{Object.entries(localePaths).map(([lang, path]) => (
  <link rel="alternate" hreflang={lang} href={`${siteBase}${path}${hreflangSuffix}`} />
))}
<link rel="alternate" hreflang="x-default" href={`${siteBase}/${hreflangSuffix}`} />

<!-- Structured data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

<!-- Google Tag Manager -->
<script is:inline define:vars={{ gtmId }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',gtmId);</script>
<!-- End Google Tag Manager -->
