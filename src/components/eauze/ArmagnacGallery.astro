---
import alambic1 from "../../assets/alambic1-resized.jpg";
import alambic3 from "../../assets/alambic3-resized.jpg";
import cepage5 from "../../assets/cepage5-resized.jpg";
import tonneau5 from "../../assets/tonneau5-resized.jpg";
import HorizontalGallery from "../HorizontalGallery.astro";

interface Props {
  alts: [string, string, string, string];
}

const { alts } = Astro.props;
---

<HorizontalGallery
  images={[
    { src: alambic1, alt: alts[0] },
    { src: alambic3, alt: alts[1] },
    { src: cepage5, alt: alts[2] },
    { src: tonneau5, alt: alts[3] },
  ]}
/>
