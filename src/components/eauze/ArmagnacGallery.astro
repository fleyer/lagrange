---
import armagnac from "../../assets/eauze/eauze_armagnac.jpg";
import wines from "../../assets/eauze/eauze_vines.jpg";
import HorizontalGallery from "../HorizontalGallery.astro";

interface Props {
  alts: [string, string, string, string];
}

const { alts } = Astro.props;
---

<HorizontalGallery
  images={[
    { src: wines, alt: alts[0] },
    { src: armagnac, alt: alts[1] },
  ]}
/>
