---
import { ChevronDown, Menu, X } from "@lucide/astro";
import { infoPageSlugs } from "../lib/infoPages";
import * as m from "../paraglide/messages.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const locales = [
  { code: "fr", label: "FR", href: `${base}/` },
  { code: "en", label: "EN", href: `${base}/en/` },
  { code: "de", label: "DE", href: `${base}/de/` },
  { code: "es", label: "ES", href: `${base}/es/` },
];
const currentLocale = Astro.currentLocale ?? "fr";
const currentLabel = locales.find((l) => l.code === currentLocale)?.label;
const homeHref =
  locales.find((l) => l.code === currentLocale)?.href ?? `${base}/`;
const eauzeHref = `${homeHref}${infoPageSlugs.eauze[currentLocale as keyof typeof infoPageSlugs.eauze] ?? infoPageSlugs.eauze.fr}/`;
const caminoHref = `${homeHref}${infoPageSlugs.camino[currentLocale as keyof typeof infoPageSlugs.camino] ?? infoPageSlugs.camino.fr}/`;
---

<header class="sticky top-0 z-50 border-b bg-base-100 border-base-300">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:z-[60] focus:rounded focus:bg-base-100 focus:px-4 focus:py-2 focus:text-base-content focus:shadow focus:outline-2 focus:outline-primary"
  >{m.skipToContent()}</a>

  <!-- Hidden checkbox drives the mobile menu open/close state; its checked state is announced natively -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer sr-only" aria-label={m.menuOpen()} aria-controls="mobile-menu" />

  <!-- Header bar -->
  <div class="navbar px-4 sm:px-8">

    <!-- Brand -->
    <div class="navbar-start">
      <a href={`${homeHref}#welcome`} class="text-xl font-bold tracking-widest no-underline text-base-content">Lagrange</a>
    </div>

    <!-- Desktop centered nav -->
    <nav aria-label={m.navMain()} class="navbar-center hidden items-center gap-6 md:inline-flex lg:gap-8">
      <a href={`${homeHref}#welcome`} class="text-sm tracking-wide no-underline hover:underline text-base-content">{m.navHome()}</a>
      <a href={`${homeHref}#the-refuge`} class="text-sm tracking-wide no-underline hover:underline text-base-content">{m.navRefuge()}</a>
      <a href={`${homeHref}#accommodations`} class="text-sm tracking-wide no-underline hover:underline text-base-content">{m.navAccommodations()}</a>
      <a href={`${homeHref}#dining`} class="text-sm tracking-wide no-underline hover:underline text-base-content">{m.navDining()}</a>
      <a href={`${homeHref}#reservation`} class="text-sm tracking-wide no-underline hover:underline text-base-content">{m.navReservation()}</a>
      <details class="dropdown nav-more">
        <summary aria-label={m.navMore()} class="flex min-h-8 cursor-pointer list-none items-center gap-1 text-sm tracking-wide text-base-content">
          {m.navMore()}
          <ChevronDown class="nav-more-chevron h-3 w-3" stroke-width={2.5} />
        </summary>
        <nav aria-label={m.navMore()} class="dropdown-content z-50 mt-1 w-44 rounded-box border p-1 shadow bg-base-100 border-base-300">
          <a href={`${homeHref}#gallery`} class="inline-flex min-h-11 w-full items-center rounded px-3 text-sm tracking-wide no-underline hover:bg-base-200 text-base-content">{m.navGallery()}</a>
          <a href={eauzeHref} class="inline-flex min-h-11 w-full items-center rounded px-3 text-sm tracking-wide no-underline hover:bg-base-200 text-base-content">{m.navEauze()}</a>
          <a href={caminoHref} class="inline-flex min-h-11 w-full items-center rounded px-3 text-sm tracking-wide no-underline hover:bg-base-200 text-base-content">{m.navCamino()}</a>
        </nav>
      </details>
    </nav>

    <!-- Right: language dropdown (desktop) + hamburger (mobile) -->
    <div class="navbar-end gap-4">
      <details class="dropdown dropdown-end hidden md:block">
        <summary aria-label={`${m.languageSwitcher()}: ${currentLabel}`} class="flex min-h-8 cursor-pointer list-none items-center gap-1 rounded px-2 py-1 text-sm font-semibold tracking-widest text-base-content hover:bg-base-200">
          {currentLabel}
          <ChevronDown class="h-3 w-3" stroke-width={2.5} />
        </summary>
        <ul class="menu dropdown-content z-50 mt-1 w-24 rounded-box border p-1 shadow bg-base-100 border-base-300">
          {locales.map(({ code, label, href }) => (
            <li>
              {code === currentLocale ? (
                <span lang={code} aria-current="true" class="text-sm font-semibold tracking-widest text-base-content">{label}</span>
              ) : (
                <a href={href} lang={code} hreflang={code} class="text-sm font-semibold tracking-widest no-underline text-base-content/70 hover:text-base-content">{label}</a>
              )}
            </li>
          ))}
        </ul>
      </details>
      <!-- Visual toggle only: the checkbox above is the accessible control -->
      <label for="mobile-menu-toggle" aria-hidden="true" class="menu-toggle-label btn btn-ghost btn-square btn-sm md:hidden text-base-content">
        <Menu class="h-5 w-5" />
      </label>
    </div>
  </div>

  <!-- Full-screen mobile menu overlay (visible when checkbox is checked) -->
  <div id="mobile-menu" class="fixed inset-0 z-50 hidden flex-col peer-checked:flex md:hidden bg-base-100">

    <!-- Overlay top bar with close button -->
    <div class="flex items-center justify-between border-b px-4 py-4 sm:px-8 border-base-300">
      <span class="text-xl font-bold tracking-widest text-base-content">Lagrange</span>
      <button type="button" id="mobile-menu-close" aria-label={m.menuClose()} class="btn btn-ghost btn-square btn-sm text-base-content">
        <X class="h-5 w-5" />
      </button>
    </div>

    <!-- Nav links -->
    <nav aria-label={m.navMobile()} class="flex flex-1 flex-col items-center justify-center gap-8">
      <a href={`${homeHref}#welcome`} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navHome()}</a>
      <a href={`${homeHref}#the-refuge`} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navRefuge()}</a>
      <a href={`${homeHref}#accommodations`} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navAccommodations()}</a>
      <a href={`${homeHref}#dining`} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navDining()}</a>
      <a href={`${homeHref}#reservation`} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navReservation()}</a>
      <span aria-hidden="true" class="text-xs font-semibold uppercase tracking-widest text-base-content/70">{m.navMoreGroup()}</span>
      <a href={`${homeHref}#gallery`} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navGallery()}</a>
      <a href={eauzeHref} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navEauze()}</a>
      <a href={caminoHref} class="text-lg tracking-wide no-underline hover:underline text-base-content">{m.navCamino()}</a>
    </nav>

    <!-- Language switcher -->
    <div class="border-t px-8 py-6 border-base-300">
      <div role="group" aria-label={m.languageSwitcher()} class="flex justify-center gap-2">
        {locales.map(({ code, label, href }) =>
          code === currentLocale ? (
            <span lang={code} aria-current="true" class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-semibold tracking-widest text-base-content">{label}</span>
          ) : (
            <a href={href} lang={code} hreflang={code} class="inline-flex min-h-11 min-w-11 items-center justify-center text-sm font-semibold tracking-widest no-underline text-base-content/70 hover:text-base-content">{label}</a>
          )
        )}
      </div>
    </div>
  </div>
</header>

<style>
  #mobile-menu-toggle:focus-visible ~ .navbar .menu-toggle-label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .nav-more-chevron {
    transition: transform 0.15s ease;
  }

  .nav-more[open] .nav-more-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const toggle = document.getElementById("mobile-menu-toggle") as HTMLInputElement | null;
  const close = document.getElementById("mobile-menu-close");

  if (toggle) {
    document.querySelectorAll("a[href*='#']").forEach((a) => {
      a.addEventListener("click", () => { toggle.checked = false; });
    });
    toggle.addEventListener("change", () => { if (toggle.checked) close?.focus(); });
    close?.addEventListener("click", () => { toggle.checked = false; toggle.focus(); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.checked) { toggle.checked = false; toggle.focus(); }
    });
  }

  const dropdowns = document.querySelectorAll<HTMLDetailsElement>("details.dropdown");

  document.addEventListener("click", (e) => {
    dropdowns.forEach((details) => {
      if (details.open && !details.contains(e.target as Node)) details.open = false;
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    dropdowns.forEach((details) => {
      if (details.open) {
        details.open = false;
        details.querySelector("summary")?.focus();
      }
    });
  });
</script>
