---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import * as m from "../paraglide/messages.js";

interface Props {
  locale: string;
  class?: string;
}

const { locale, class: className } = Astro.props;
const entry = await getEntry("accommodations", locale);
if (!entry)
  throw new Error(`Missing accommodations content for locale: ${locale}`);

const imagesEntry = await getEntry("accommodationsImages", "index");
if (!imagesEntry) throw new Error("Missing accommodations images");

const unitImages = imagesEntry.data.units;
---

<section id="accommodations" class:list={["min-h-[80svh] bg-base-200 px-4 py-16", className]}>
  <div class="mx-auto max-w-4xl py-4">
    <h2 class="mb-6 text-center text-4xl font-normal text-base-content sm:text-5xl lg:text-6xl">{entry.data.title}</h2>
    {entry.data.description && (
      <p class="mx-auto mb-10 max-w-2xl text-center text-base-content/70">{entry.data.description}</p>
    )}

    <div class="mb-12 grid gap-6 sm:grid-cols-3">
      {entry.data.units.map((unit, i) => {
        const unitConfig = unitImages.find(unitImage => unitImage.id === unit.id);
        const images = unitConfig?.images ?? []
        const color = unitImages[i]?.color;

        return (
          <div class={`card overflow-hidden ${color ? "border-solid border-2" : "border-solid border-1 border-black/20"}`} style={ color ? {"border-color": color} : {}}}>
            {images.length > 0 && (
              <figure class="relative h-48 overflow-visible">
                <div class="carousel h-full w-full">
                  {images.map((img) => (
                    <div class="carousel-item h-full w-full">
                      <Image
                        src={img}
                        alt={`${unit.name} — Gîte La Grange 2027, Éauze`}
                        class="h-full w-full object-cover"
                      />
                    </div>
                  ))}
                </div>
                {images.length > 1 && (
                  <div class="absolute bottom-0 flex w-full justify-center">
                    {images.map((_, j) => (
                      <button
                        type="button"
                        data-slide-index={j}
                        class="group flex h-6 w-6 items-center justify-center border-0 bg-transparent p-0 cursor-pointer"
                        aria-label={m.photoLabel({ n: j + 1 })}
                      >
                        <span class="h-2 w-2 rounded-full bg-white opacity-60 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"></span>
                      </button>
                    ))}
                  </div>
                )}
              </figure>
            )}
            <div class="card-body">
              <h3 class="card-title text-(--unit-color) dark:text-[oklch(from_var(--unit-color)_calc(l+0.15)_c_h)]" style={{"--unit-color": color}}>{unit.name}</h3>
              <div>
                <p class="text-sm text-primary dark:text-[oklch(from_var(--color-primary)_calc(l+0.15)_c_h)]">{unit.capacity}</p>
                <p class="mt-4 text-base-content" set:html={unit.description}></p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <div class="list rounded-box mx-auto max-w-sm">
      {entry.data.pricing.map((row) => (
        <div class="list-row flex justify-between py-2 text-base-content">
          <span>{row.label}</span>
          <span class="font-medium">{row.price}</span>
        </div>
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <a href="#reservation" class="btn btn-primary btn-lg">{m.accommodationsCta()}</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-slide-index]").forEach((dot) => {
    dot.addEventListener("click", () => {
      const index = parseInt(dot.dataset.slideIndex!);
      const carousel = dot.closest("figure")!.querySelector(".carousel")!;
      const item = carousel.querySelectorAll<HTMLElement>(".carousel-item")[index];
      carousel.scrollTo({ left: item.offsetLeft, behavior: "smooth" });
    });
  });
</script>
